# Bí mật ký cookie phiên admin (bắt buộc, ≥ 32 ký tự ngẫu nhiên)
AUTH_SECRET=change-me-to-a-long-random-string

# Trống = PGlite (Postgres nhúng, ./data/pglite, tự nạp shop demo). Chạy thật: chuỗi Postgres (Supabase Session Pooler / Neon).
DATABASE_URL=
DATABASE_SSL_CA=
# Tạo shop + admin đầu tiên khi DB thật còn trống
BOOTSTRAP_SHOP_NAME=
BOOTSTRAP_SHOP_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# true = nạp shop demo + dữ liệu mẫu vào DB thật
SEED_DEMO=
# false = không sinh 30 ngày dữ liệu phân tích giả cho shop demo
SEED_DEMO_ANALYTICS=

# URL công khai của app (sinh mã nhúng, link trong thông báo webhook)
PUBLIC_BASE_URL=http://localhost:3000

# ---- AI (OpenRouter) ----
# Không có key = bot theo luật + phân loại theo luật (vẫn chạy đủ chức năng, kém thông minh hơn).
OPENROUTER_API_KEY=
# rules = ép dùng bot theo luật dù có key
LLM_PROVIDER=

# Tầng quyết định (Phase 2C) chạy TRƯỚC LLM chính: jev | rules | off. Mặc định jev nếu có key.
DECISION_PROVIDER=
# TypeSafe Jev Router — chọn model + mức suy luận theo từng request
DECISION_MODEL=typesafe/jev-router
DECISION_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash

# LLM trả lời theo độ khó jev đánh giá (model đầu = chính, sau = dự phòng; cần hỗ trợ tool calling)
OPENROUTER_MODEL_SIMPLE=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash
OPENROUTER_MODEL_COMPLEX=anthropic/claude-haiku-5.5,z-ai/glm-5.3-flash

# deny (mặc định) = chỉ dùng nhà cung cấp không lưu dữ liệu — nên dùng khi có dữ liệu khách thật.
# allow = cần cho model :free và một số nhà cung cấp mà jev-router có thể chọn (chỉ test với dữ liệu giả).
OPENROUTER_DATA_COLLECTION=deny
