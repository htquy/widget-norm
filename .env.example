# Bí mật ký cookie phiên admin (bắt buộc, ≥ 32 ký tự ngẫu nhiên)
AUTH_SECRET=change-me-to-a-long-random-string

# Trung tâm tài khoản, thanh toán và AI (skill-pages). Đăng ký callback chính xác:
# <PUBLIC_BASE_URL>/api/auth/hub/callback. Bật HUB_CLIENT_ID sẽ yêu cầu SSO trước đăng ký bot.
HUB_BASE_URL=http://localhost:3000
HUB_CLIENT_ID=widget-norm
HUB_CLIENT_SECRET=
HUB_APP_AVI=avi
HUB_APP_TILE=avi-tile
HUB_APP_EDU=avi-edu
HUB_APP_FURNITURE=avi-furniture
# Key CLIENT của gateway; không phải key OpenRouter. Key nhà cung cấp chỉ lưu tại skill-pages.
HUB_GATEWAY_KEY=
HUB_AI_PROVIDER=openrouter

# Trống = PGlite (Postgres nhúng, ./data/pglite, tự nạp shop demo). Chạy thật: chuỗi Postgres (Supabase Session Pooler / Neon).
DATABASE_URL=
DATABASE_SSL_CA=
# Tạo shop + admin đầu tiên khi DB thật còn trống
BOOTSTRAP_SHOP_NAME=
BOOTSTRAP_SHOP_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Loại bot đầu tiên: store | tile (mặc định store). Người dùng khác tự đăng ký ở /signup
BOOTSTRAP_BOT_KIND=
# true = nạp shop demo + dữ liệu mẫu vào DB thật
SEED_DEMO=
# false = không sinh 30 ngày dữ liệu phân tích giả cho shop demo
SEED_DEMO_ANALYTICS=

# URL công khai của app (sinh mã nhúng, link trong thông báo webhook)
PUBLIC_BASE_URL=http://localhost:3001

# ---- AI (OpenRouter) ----
# Không có key = bot theo luật + phân loại theo luật (vẫn chạy đủ chức năng, kém thông minh hơn).
OPENROUTER_API_KEY=
# rules = ép dùng bot theo luật dù có key
LLM_PROVIDER=

# Tầng quyết định (Phase 2C) chạy TRƯỚC LLM chính: jev | rules | off. Mặc định jev nếu có key.
DECISION_PROVIDER=
# TypeSafe Jev Router — chọn model + mức suy luận theo từng request
DECISION_MODEL=typesafe/jev-router
DECISION_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash

# LLM trả lời theo độ khó jev đánh giá (model đầu = chính, sau = dự phòng; cần hỗ trợ tool calling)
OPENROUTER_MODEL_SIMPLE=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash
OPENROUTER_MODEL_COMPLEX=anthropic/claude-haiku-5.5,z-ai/glm-5.3-flash

# deny (mặc định) = chỉ dùng nhà cung cấp không lưu dữ liệu — nên dùng khi có dữ liệu khách thật.
# allow = cần cho model :free và một số nhà cung cấp mà jev-router có thể chọn (chỉ test với dữ liệu giả).
OPENROUTER_DATA_COLLECTION=deny

# ---- Website thương mại ----
# Email nhận liên hệ gói Doanh nghiệp (trống = ẩn nút liên hệ)
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Lưu ảnh (vân gạch, ảnh phối cảnh của khách) ----
# Trống = lưu đĩa ./storage (chỉ để dev). Điền đủ 4 biến đầu = dùng Cloudflare R2.
STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL công khai của bucket; bucket phải có CORS GET cho domain app/web shop (trình xem thử dùng WebGL)
R2_PUBLIC_URL=

# ---- Nội thất: tạo 3D từ ảnh (tuỳ chọn) ----
# Máy chủ GPU chạy TRELLIS.2 theo hợp đồng ở scripts/trellis-worker/README.md. Để trống = ẩn nút "Tạo 3D nháp bằng AI".
TRELLIS_API_URL=
TRELLIS_API_KEY=
